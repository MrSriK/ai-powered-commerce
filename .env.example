# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=<datasource-url>
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>

# Auth0 OIDC Identity Provider Configuration
APP_AUTH_AUDIENCE=<auth0-audience-uri>
AUTH0_CLIENT_ID=<auth0-client-id>
AUTH0_CLIENT_SECRET=<auth0-client-secret>
AUTH0_DOMAIN=<auth0-tenant-domain>
AUTH0_CONNECTION=Username-Password-Authentication

# Internal API Key for Automated Order Progression
APP_INTERNAL_API_KEY=your-internal-api-key-here

# Spring AI Google Gemini Configuration
SPRING_AI_GOOGLE_GENAI_API_KEY=your-gemini-api-key-here
SPRING_AI_GOOGLE_GENAI_CHAT_MODEL=gemini-2.5-flash
